model MeritThreshold {
  id      String @id @default(cuid())
  bandMin Int
  bandMax Int?
  pos1    Int
  pos2    Int
  pos3    Int
  pos4    Int

  @@map("merit_thresholds")
}

model RecurringTournamentRegistration {
  id          String              @id @default(cuid())
  templateId  String
  userId      String
  missedCount Int                 @default(0)
  optedOutAt  DateTime?
  createdAt   DateTime            @default(now())
  /// Phase 3.7a: FK now targets TournamentTemplate (was Tournament with
  /// isRecurring:true). Cascade so deleting a template cleans up subs.
  template    TournamentTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
  @@index([templateId])
  @@index([userId])
  @@map("recurring_tournament_registrations")
}

model TournamentSeedBot {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@map("tournament_seed_bots")
}

/// Phase 3.7a.6 — append-only audit log of tournaments the sweep hard-
/// deleted for being unfilled + bot-only. The delete removes the source
/// Tournament row, so a post-hoc COUNT is impossible; this row is written
/// immediately before the delete so admins can still see "how often is
/// this happening" as a health signal for scheduling / seed-bot tuning.
/// No FKs — the referenced Tournament (and possibly Template) may be gone.
model TournamentAutoDrop {
  id                   String   @id @default(cuid())
  originalTournamentId String?
  templateId           String?
  name                 String
  game                 String
  minParticipants      Int
  participantCount     Int
  droppedAt            DateTime @default(now())

  @@index([droppedAt])
  @@map("tournament_auto_drops")
}

/// Phase 3.7a — seed bots attached to a recurring-tournament *template*.
/// Every spawned occurrence inherits these; the `TournamentSeedBot` table
/// above stays for per-occurrence overrides on one-shot tournaments.
model TournamentTemplateSeedBot {
  id         String             @id @default(cuid())
  templateId String
  userId     String
  template   TournamentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id])
  createdAt  DateTime           @default(now())

  @@unique([templateId, userId])
  @@index([templateId])
  @@map("tournament_template_seed_bots")
}

model Table {
  id                String      @id @default(cuid())
  gameId            String
  status            TableStatus @default(FORMING)
  createdById       String
  minPlayers        Int
  maxPlayers        Int
  isPrivate         Boolean     @default(false)
  chatEnabled       Boolean     @default(false)
  isTournament      Boolean     @default(false)
  /// Array of seat objects: { userId: string|null, status: "occupied" | "empty" }.
  /// Length always equals maxPlayers; empty seats have userId: null.
  seats             Json
  /// Full game state blob — replaces the in-memory Room's board/turn/scores.
  /// Shape: { board, currentTurn, scores, round, winner, winLine, marks, botMark, moves }
  /// Updated on every move; game-defined but platform reads status fields for
  /// lifecycle decisions (e.g., marking Table COMPLETED on winner).
  previewState      Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  /// Phase 3.4 — tournament context (null for free-play tables).
  tournamentMatchId String?
  tournamentId      String?
  bestOfN           Int?
  /// A2 — ranked-match context. NULL for casual + tournament tables.
  /// When set, game-end on this table calls `advanceMatchAfterGame`; the
  /// table is reused for game 2 via rematch-in-place with swapped colors.
  matchId           String?
  /// Phase 3.4 — bot context (null for PvP tables).
  isHvb             Boolean     @default(false)
  botUserId         String?
  botSkillId        String?
  /// Opaque URL slug (nanoid). Unique per row; UI labels are computed on read
  /// from seats + tournament context (see lib/tableLabel.js), not stored here.
  slug              String?     @unique
  /// True for Hook-phase "Watch bots battle" demo tables. Private to the creator,
  /// GC'd aggressively (one active per user, 2-min-post-complete, 1-hour TTL).
  /// See Intelligent_Guide_Requirements.md §5.1.
  isDemo            Boolean     @default(false)
  /// Realtime transport this table was opened with: 'socketio' or 'sse'.
  /// Pinned at create time from `realtime.gameflow.via` SystemConfig so a
  /// mid-rollout PvP doesn't end up with players on different transports —
  /// per Realtime_Migration_Plan.md Risk R7. The legacy default keeps prod
  /// safe before the flag flip.
  gameflowVia       String      @default("socketio")

  @@index([status])
  @@index([gameId])
  @@index([createdById])
  @@index([isTournament])
  @@index([tournamentMatchId])
  @@index([matchId])
  @@index([botUserId])
  @@index([isDemo])
  @@map("tables")
}

/// Daily aggregate snapshot written by a UTC-midnight cron job. The admin
/// `/admin/guide-metrics` dashboard reads from this table for historical
/// trend data; real-time metrics query raw events (users, games,
/// tournaments) directly. All aggregation queries filter
/// `WHERE user.isTestUser = false`. Retention defaults to indefinite
/// (see Intelligent_Guide_Requirements.md §2).
///
/// `dimensions` is a free-form JSON slicer: e.g. `{ "bucket": "designer" }`
/// for per-bucket breakdowns or `{ "cohortWeek": "2026-W17" }` for
/// cohort-sliced snapshots. The `(date, metric, dimensions)` unique index
/// makes re-running the cron for the same UTC date idempotent (same
/// dimensions → same row → upsert, never duplicates).
model MetricsSnapshot {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  metric     String
  value      Float
  dimensions Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([date])
  @@index([metric])
  @@map("metrics_snapshots")
}

/// RUM (Real-User Monitoring) Web Vitals beacon — one row per individual
/// metric (FCP/LCP/INP/CLS/TTFB) per page session. Written by
/// POST /api/v1/perf/vitals from landing's `lib/rum.js` on `pagehide`.
/// Anonymous: `sessionId` is a tab-scoped random id, never a userId.
model PerfVital {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  env             String?
  releaseVersion  String?
  sessionId       String
  route           String
  name            String
  value           Float
  rating          String?
  navigationType  String?
  deviceClass     String?
  effectiveType   String?
  userAgent       String?
  // F11.5 — 'first-visit' | 'returning' | 'unknown'.
  // Drives admin dashboard cohort split (returning-user vs new-user perf).
  cohort          String?

  @@index([name, route, createdAt])
  @@index([env, name, createdAt])
  @@index([cohort, name, createdAt])
  @@map("perf_vitals")
}

/// Learnable Help System — see doc/Help_System_Plan.md.
/// HelpDoc is the canonical source of a help article after seeding. The
/// markdown corpus in /doc/Help_Corpus/ is additive-only on boot (new slugs
/// are created; existing rows are never overwritten by the seeder). The
/// `version` field doubles as an optimistic-locking token for the admin
/// editor and as the chunk-invalidation key: chunks are regenerated whenever
/// `version` is bumped.
model HelpDoc {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  body            String
  category        String
  tags            String[]      @default([])
  status          HelpDocStatus @default(PUBLISHED)
  authorId        String?
  lastEditedById  String?
  version         Int           @default(1)
  seededFromFile  String?
  source          String        @default("guide")
  ownerId         String?
  owner           User?         @relation("HelpDocOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  chunks          HelpChunk[]

  @@index([status])
  @@index([category])
  @@index([source])
  @@index([ownerId])
  @@map("help_docs")
}

/// Chunked, indexed view of a HelpDoc for retrieval. `tsv` is the FTS column
/// (English config) populated via a trigger; `embedding` is a pgvector
/// column (384-dim MiniLM-L6-v2 in v1) for cosine-similarity search. Both
/// indexes (GIN on tsv, ivfflat on embedding) are created in the migration
/// since Prisma cannot express them in schema.prisma.
model HelpChunk {
  id             String                  @id @default(cuid())
  docId          String
  position       Int
  content        String
  tsv            Unsupported("tsvector")?
  embedding      Unsupported("vector(384)")?
  docVersion     Int
  /// Embedding provider+model+dim that produced `embedding`. Used by the
  /// boot-time auto-reindex check (`reindexAllIfStale`) to detect rows
  /// embedded under a different model and reindex them once. Sprint 1
  /// rows are backfilled to 'stub'; Sprint 2's OpenAI embeds write
  /// 'text-embedding-3-small@384'.
  embeddingModel String                  @default("stub")
  createdAt      DateTime                @default(now())
  doc            HelpDoc                 @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@index([embeddingModel])
  @@map("help_chunks")
}

/// Records every help query for retrieval-quality analysis and the curation
/// queue. `userId` is nullable so we can later opt-in to logging guest
/// queries; v1 returns 401 to guests so this is unused until then.
model HelpQuery {
  id                 String                       @id @default(cuid())
  userId             String?
  text               String
  textTsv            Unsupported("tsvector")?
  embedding          Unsupported("vector(384)")?
  retrievedChunkIds  String[]                     @default([])
  retrievalScore     Json                         @default("{}")
  topAnswerId        String?
  context            Json                         @default("{}")
  promptTemplate     String?
  modelVersion       String?
  latencyMs          Int?
  /// True when retrieval ran in fts-only fallback (embedding generation
  /// failed). Set by helpService.search on embedClient error. Surfaced in
  /// the admin Health dashboard so vendor incidents are visible quickly.
  degraded           Boolean                      @default(false)
  /// Short upstream-error message (truncated to 200 chars) explaining the
  /// degradation. Null when degraded=false.
  degradedReason     String?
  createdAt          DateTime                     @default(now())
  answers            HelpAnswer[]

  @@index([userId])
  @@index([createdAt])
  @@index([degraded, createdAt])
  @@map("help_queries")
}

/// One HelpAnswer per generated response. `contentFilterTriggered` flips
/// when the post-stream denylist matches; `rendered` is then replaced with
/// the refusal phrase before persistence (see Help_System_Plan §7.6).
model HelpAnswer {
  id                      String         @id @default(cuid())
  queryId                 String
  chunkIds                String[]       @default([])
  rendered                String
  rank                    Int            @default(0)
  tokensIn                Int?
  tokensOut               Int?
  stopReason              String?
  contentFilterTriggered  Boolean        @default(false)
  contentFilterTerms      String[]       @default([])
  /// Curation review stamps (Sprint 4 §4.2). `reviewedById` is the User.id
  /// of the HELP_ADMIN who marked this answer reviewed in the curation
  /// queue. No `@relation` to User — mirrors `HelpDoc.lastEditedById`.
  reviewedAt              DateTime?
  reviewedById            String?
  createdAt               DateTime       @default(now())
  query                   HelpQuery      @relation(fields: [queryId], references: [id], onDelete: Cascade)
  feedback                HelpFeedback[]

  @@index([queryId])
  @@index([reviewedAt])
  @@map("help_answers")
}

/// Upsert-shaped — unique on (userId, queryId, answerId). `signal` is
/// nullable so we can record implicit signals (followUpWithin60s,
/// docLinkClicked) without forcing a thumb vote.
model HelpFeedback {
  id         String                @id @default(cuid())
  userId     String
  queryId    String
  answerId   String
  signal     HelpFeedbackSignal?
  category   HelpFeedbackCategory?
  comment    String?
  implicit   Json                  @default("{}")
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  answer     HelpAnswer            @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userId, queryId, answerId])
  @@index([answerId])
  @@map("help_feedback")
}

