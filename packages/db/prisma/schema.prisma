generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                   @id @default(cuid())
  clerkId                String?                  @unique
  username               String                   @unique
  email                  String                   @unique
  displayName            String
  avatarUrl              String?
  oauthProvider          String?
  preferences            Json                     @default("{}")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  banned                 Boolean                  @default(false)
  skillLimit             Int?
  betterAuthId           String?                  @unique
  botActive              Boolean                  @default(true)
  botAvailable           Boolean                  @default(false)
  botProvisional         Boolean                  @default(false)
  botCompetitive         Boolean                  @default(false)
  botInTournament        Boolean                  @default(false)
  botLimit               Int?
  /// Nullable pointer to the bot's *primary* (or last-trained) skill — see
  /// Phase 3.8 in Platform_Implementation_Plan.md. Source of truth for the
  /// full skill set is `BotSkill.findMany({ where: { botId } })`; this field
  /// is a UI-convenience alias the runtime reads via
  /// `botGameRunner.parseBotModelId` (built-in bots use the well-known
  /// `builtin:minimax:<tier>` form). Set on first skill add, repointed on
  /// training completion or when the primary skill is deleted.
  botModelId             String?                  @unique
  botModelType           String?
  botOwnerId             String?
  isBot                  Boolean                  @default(false)
  botEloResetAt          DateTime?
  botGamesPlayed         Int                      @default(0)
  creditsBpc             Int                      @default(0)
  creditsHpc             Int                      @default(0)
  creditsTc              Int                      @default(0)
  nameConfirmed          Boolean                  @default(false)
  lastActiveAt           DateTime?
  emailAchievements      Boolean                  @default(false)
  /// Excludes this user from all dashboard/metrics aggregations. Set true on
  /// account creation for admins, seed-script accounts, and emails whose domain
  /// matches the `metrics.internalEmailDomains` SystemConfig entry. Admins who
  /// want their activity counted can flip their own flag via a Settings toggle.
  /// See Intelligent_Guide_Requirements.md §2 (pollution prevention).
  isTestUser             Boolean                  @default(false)
  feedback               Feedback[]
  gameElo                GameElo[]
  gamesAsPlayer1         Game[]                   @relation("Player1Games")
  gamesAsPlayer2         Game[]                   @relation("Player2Games")
  gamesWon               Game[]                   @relation("WinnerGames")
  matchesAsPlayer1       Match[]                  @relation("Player1Matches")
  matchesAsPlayer2       Match[]                  @relation("Player2Matches")
  matchesWon             Match[]                  @relation("WinnerMatches")
  notifPreferences       NotificationPreference[]
  classification         PlayerClassification?
  tournamentParticipants TournamentParticipant[]
  eloHistory             UserEloHistory[]
  notifications          UserNotification[]
  pushSubscriptions      PushSubscription[]
  userRoles              UserRole[]
  seedBotConfigs         TournamentSeedBot[]
  templateSeedBotConfigs TournamentTemplateSeedBot[]
  researchNotes          TrainingSessionNote[]
  researchEntries        ResearchLogEntry[]
  approvedTrainingSessions TrainingSession[]  @relation("ApprovedTrainingSessions")
  helpDocsOwned          HelpDoc[]                 @relation("HelpDocOwner")

  @@map("users")
}

model Feedback {
  id             String           @id @default(cuid())
  appId          String           @default("xo-arena")
  userId         String?
  category       FeedbackCategory @default(OTHER)
  status         FeedbackStatus   @default(OPEN)
  message        String
  pageUrl        String
  screenshotData String?
  userAgent      String?
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  readAt         DateTime?
  user           User?            @relation(fields: [userId], references: [id])
  replies        FeedbackReply[]

  @@index([appId])
  @@index([status])
  @@index([createdAt])
  @@index([readAt])
  @@index([archivedAt])
  @@map("feedback")
}

model FeedbackReply {
  id         String   @id @default(cuid())
  feedbackId String
  adminId    String
  message    String
  createdAt  DateTime @default(now())
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@map("feedback_replies")
}

model UserRole {
  id          String   @id @default(cuid())
  userId      String
  role        Role
  grantedById String
  grantedAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model UserEloHistory {
  id           String   @id @default(cuid())
  userId       String
  eloRating    Float
  delta        Float
  opponentType String
  outcome      String
  recordedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_elo_history")
}

/// Current ELO rating for a user in a specific game (replaces User.eloRating).
/// Note: game_elo table uses snake_case columns — @map required on all non-trivial fields.
model GameElo {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  gameId      String   @map("game_id")
  rating      Float    @default(1200)
  gamesPlayed Int      @default(0) @map("games_played")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId])
  @@map("game_elo")
}

model Game {
  id                 String           @id @default(cuid())
  player1Id          String
  player2Id          String?
  winnerId           String?
  mode               GameMode
  aiImplementationId String?
  difficulty         Difficulty?
  outcome            Outcome
  totalMoves         Int
  durationMs         Int
  startedAt          DateTime
  endedAt            DateTime         @default(now())
  roomName           String?
  appId              String           @default("xo-arena")
  tournamentId       String?
  tournamentMatchId  String?
  /// Ranked match this game belongs to. NULL for casual single-game play and
  /// for tournament games (those use `tournamentMatchId`). Set by the ranked
  /// orchestrator when minting game N of a best-of-2 match.
  matchId            String?
  /// 1-indexed position within the match (1 or 2 for ranked BO2). NULL when
  /// `matchId` is NULL.
  matchSequence      Int?
  isTournament       Boolean          @default(false)
  /// True when the game is a user-initiated spar match (bot vs system bot,
  /// outside any tournament). Preserved for 30 days per §5.2 retention policy;
  /// excluded from ELO/ranking calculations. See Intelligent_Guide_Requirements.md §5.2.
  isSpar             Boolean          @default(false)
  moveStream         Json?
  aiErrors           AIError[]
  player1            User             @relation("Player1Games", fields: [player1Id], references: [id])
  player2            User?            @relation("Player2Games", fields: [player2Id], references: [id])
  tournament         Tournament?      @relation(fields: [tournamentId], references: [id])
  tournamentMatch    TournamentMatch? @relation(fields: [tournamentMatchId], references: [id])
  match              Match?           @relation(fields: [matchId], references: [id])
  winner             User?            @relation("WinnerGames", fields: [winnerId], references: [id])
  moves              Move[]

  @@index([outcome])
  @@index([aiImplementationId])
  @@index([difficulty])
  @@index([endedAt])
  @@index([player1Id])
  @@index([player2Id])
  @@index([tournamentId])
  @@index([matchId])
  @@index([isSpar])
  @@map("games")
}

model Move {
  id            String     @id @default(cuid())
  gameId        String
  moveNumber    Int
  player        MovePlayer
  boardState    Json
  cellIndex     Int
  computationMs Int?
  timestamp     DateTime   @default(now())
  game          Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("moves")
}

model AIError {
  id               String   @id @default(cuid())
  gameId           String
  moveNumber       Int
  implementationId String
  errorType        String
  message          String
  stackTrace       String?
  timestamp        DateTime @default(now())
  game             Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([implementationId])
  @@map("ai_errors")
}

model BotSkill {
  id             String              @id(map: "ml_models_pkey") @default(cuid())
  name           String
  description    String?
  algorithm      String
  weights        Json                @default("{}")
  config         Json
  status         BotSkillStatus      @default(IDLE)
  totalEpisodes  Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  featured       Boolean             @default(false)
  createdBy      String?
  maxEpisodes    Int                 @default(100000)
  botId          String?             @map("bot_id")
  gameId         String              @default("tic-tac-toe") @map("game_id")
  benchmarks     MLBenchmarkResult[]
  checkpoints    MLCheckpoint[]
  eloHistory     MLEloHistory[]
  playerProfiles MLPlayerProfile[]
  sessions       TrainingSession[]

  @@unique([botId, gameId], where: raw("(bot_id IS NOT NULL)"))
  @@map("bot_skills")
}

model MLPlayerProfile {
  id                 String   @id @default(uuid())
  modelId            String
  userId             String
  gamesRecorded      Int      @default(0)
  movePatterns       Json     @default("{}")
  openingPreferences Json     @default("{}")
  tendencies         Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  model              BotSkill @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, userId])
  @@map("ml_player_profiles")
}

model TrainingSession {
  id          String            @id @default(cuid())
  modelId     String
  mode        TrainingMode
  iterations  Int
  status      SessionStatus     @default(PENDING)
  config      Json
  summary     Json?
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  /// A3a — preset label: 'quick' / 'standard' / 'deep'. Null for
  /// manually-configured / legacy sessions.
  preset      String?
  /// A3a — estimated runtime computed at session creation (used for the
  /// admin-approval ETA gate and for surfacing time-to-finish in the UI).
  expectedDurationMs   Int?
  /// A3a — admin-approval flow for sessions whose `expectedDurationMs`
  /// exceeds the threshold (4hr today). 'NEEDED' until an admin acts;
  /// 'APPROVED' or 'DENIED' on decision. Null means no approval required.
  approvalStatus       String?
  approvalRequestedAt  DateTime?
  approvedAt           DateTime?
  approvedById         String?
  approvedBy           User?     @relation("ApprovedTrainingSessions", fields: [approvedById], references: [id])
  /// A3a — Resume button. Set when the user pauses; cleared on resume.
  pausedAt    DateTime?
  /// A3a — episodeNum of the latest persisted checkpoint. The worker reads
  /// this on startup to know where to resume from. Null until the first
  /// checkpoint commits.
  checkpointEpisode    Int?
  episodes    TrainingEpisode[]
  notes       TrainingSessionNote[]
  checkpoints TrainingCheckpoint[]
  metrics     TrainingMetric[]
  model       BotSkill          @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@index([approvalStatus])
  @@map("training_sessions")
}

/// A3a — checkpoint-based recovery. Persisted every N episodes during a
/// training run; on worker crash, the next worker reads the latest
/// checkpoint for the session and resumes from there. `weights` carries
/// the algorithm-specific weight blob (Q-table for Q-learning, network
/// state for DQN, AlphaZero policy/value, etc.) at that point.
model TrainingCheckpoint {
  id         String          @id @default(cuid())
  sessionId  String
  episodeNum Int
  weights    Json
  /// Algorithm-specific runtime state needed to resume (epsilon, replay
  /// buffer pointer, MCTS tree fingerprint, etc.). Distinct from
  /// `weights` so the network blob doesn't bloat with bookkeeping.
  runtimeState Json?
  createdAt  DateTime        @default(now())
  session    TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, episodeNum])
  @@index([sessionId])
  @@map("training_checkpoints")
}

/// A3a — time-series eval points for the stacked W/D/L curves. One row per
/// eval call per opponent curve. `opponentLabel` is a free-form string
/// ('primary' for the algorithm-appropriate primary opponent, 'easy' /
/// 'medium' / 'master' for the side curves). The frontend renders one
/// stacked area per label.
model TrainingMetric {
  id            String          @id @default(cuid())
  sessionId     String
  episodeNum    Int
  opponentLabel String
  wins          Int             @default(0)
  draws         Int             @default(0)
  losses        Int             @default(0)
  /// Optional: when the eval split first-mover vs second-mover (Master
  /// curve, AlphaZero phase B). Null for unsplit curves.
  asFirstMover  Boolean?
  createdAt     DateTime        @default(now())
  session       TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, opponentLabel, episodeNum])
  @@map("training_metrics")
}

model TrainingEpisode {
  id         String          @id @default(cuid())
  sessionId  String
  episodeNum Int
  outcome    EpisodeOutcome
  totalMoves Int
  avgQDelta  Float
  epsilon    Float
  durationMs Int
  session    TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("training_episodes")
}

model TrainingSessionNote {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId           String
  session             TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  body                String
  outcome             NoteOutcome
  tags                String[]

  sharedWithCommunity Boolean     @default(false)
  publishedAt         DateTime?
  helpDocId           String?     @unique

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([sharedWithCommunity, publishedAt])
  @@map("training_session_notes")
}

model ResearchLogEntry {
  id                  String                @id @default(cuid())
  userId              String
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  title               String
  body                String
  tags                String[]              @default([])
  category            ResearchEntryCategory

  sharedWithCommunity Boolean               @default(false)
  publishedAt         DateTime?
  helpDocId           String?               @unique

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([userId, createdAt])
  @@index([sharedWithCommunity, publishedAt])
  @@map("research_log_entries")
}

/// Materialised "view" over TrainingSessionNote + ResearchLogEntry — refreshed
/// nightly via truncate-and-insert (backend/src/jobs/researchLogExport.js).
/// Powers downstream analytics and the Sprint-5+ reranker training feed; not
/// served on the request path. Source-of-truth rows live in the original
/// tables; this table is disposable and rebuilt from scratch each run.
model ResearchLogExport {
  id                  String     @id      // source row id, prefixed by `type`
  type                String              // 'note' | 'entry'
  userId              String
  body                String
  outcome             String?            // notes only
  title               String?            // entries only
  category            String?            // entries only
  tags                String[]   @default([])
  sharedWithCommunity Boolean    @default(false)
  publishedAt         DateTime?
  helpDocId           String?
  sourceCreatedAt     DateTime
  sourceUpdatedAt     DateTime
  exportedAt          DateTime   @default(now())

  @@index([userId])
  @@index([type])
  @@index([sharedWithCommunity, publishedAt])
  @@map("research_log_exports")
}

model MLCheckpoint {
  id         String   @id @default(cuid())
  modelId    String
  episodeNum Int
  weights    Json
  epsilon    Float
  createdAt  DateTime @default(now())
  model      BotSkill @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@map("ml_checkpoints")
}

model MLBenchmarkResult {
  id       String   @id @default(cuid())
  modelId  String
  runAt    DateTime @default(now())
  vsRandom Json
  vsEasy   Json
  vsMedium Json
  vsHard   Json
  summary  Json
  vsTough  Json?
  model    BotSkill @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@map("ml_benchmark_results")
}

model MLEloHistory {
  id           String         @id @default(cuid())
  modelId      String
  eloRating    Float
  delta        Float
  opponentId   String?
  opponentType String
  outcome      EpisodeOutcome
  recordedAt   DateTime       @default(now())
  model        BotSkill       @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@map("ml_elo_history")
}

model RuleSet {
  id           String   @id @default(cuid())
  name         String
  description  String?
  rules        Json     @default("[]")
  sourceModels Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("rule_sets")
}

model MLTournament {
  id           String    @id @default(cuid())
  status       String    @default("PENDING")
  modelIds     Json
  gamesPerPair Int       @default(50)
  results      Json      @default("{}")
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@map("ml_tournaments")
}

model Log {
  id        String   @id @default(cuid())
  level     String
  source    String
  message   String
  userId    String?
  sessionId String?
  roomId    String?
  meta      Json?
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([level])
  @@index([source])
  @@map("logs")
}

model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

model BaUser {
  id            String      @id
  name          String
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  role          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now())
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?
  accounts      BaAccount[]
  sessions      BaSession[]

  @@map("ba_users")
}

model BaSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  userId    String
  user      BaUser   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token])
  @@map("ba_sessions")
}

model BaAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now())
  user                  BaUser    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("ba_accounts")
}

model Jwks {
  id         String   @id
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())

  @@map("ba_jwks")
}

model BaVerification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("ba_verifications")
}

model UserNotification {
  id          String    @id @default(cuid())
  userId      String
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  emailedAt   DateTime?
  readAt      DateTime?
  expiresAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deliveredAt])
  @@map("user_notifications")
}

model NotificationPreference {
  id        String  @id @default(cuid())
  userId    String
  eventType String
  inApp     Boolean @default(true)
  email     Boolean @default(false)
  sms       Boolean @default(false)
  push      Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType])
  @@map("notification_preferences")
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model ScheduledJob {
  id          String             @id @default(cuid())
  type        String
  payload     Json
  runAt       DateTime
  status      ScheduledJobStatus @default(PENDING)
  attempts    Int                @default(0)
  maxAttempts Int                @default(3)
  lastError   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, runAt])
  @@map("scheduled_jobs")
}

model Tournament {
  id                      String                  @id @default(cuid())
  name                    String
  description             String?
  game                    String
  mode                    TournamentMode
  format                  TournamentFormat
  bracketType             BracketType
  status                  TournamentStatus        @default(DRAFT)
  minParticipants         Int                     @default(2)
  maxParticipants         Int?
  bestOfN                 Int                     @default(3)
  botMinGamesPlayed       Int?
  allowNonCompetitiveBots Boolean                 @default(false)
  allowSpectators         Boolean                 @default(true)
  startTime               DateTime?
  endTime                 DateTime?
  registrationOpenAt      DateTime?
  registrationCloseAt     DateTime?
  noticePeriodMinutes     Int?
  durationMinutes         Int?
  // Phase 3.7a — recurrence config lives exclusively on TournamentTemplate.
  // An occurrence's link back to its template is `templateId`; all other
  // recurrence fields (interval / end / paused / auto-opt-out) dropped in
  // the 20260423150000_drop_tournament_recurrence_columns migration.
  templateId              String?
  template                TournamentTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdById             String
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  paceMs                  Int?                    @map("pace_ms")
  startMode               TournamentStartMode     @default(AUTO)
  // True when created by an automated test suite; hidden from the public
  // /tournaments page (filtered at the API layer) and exposed behind an
  // admin toggle. Never set by end users.
  isTest                  Boolean                 @default(false)
  /// True for Curriculum Cup and Rookie Cup clones (curated-field guided
  /// tournaments). Private to the creator, excluded from ELO / rankings,
  /// GC'd after 30 days. See Intelligent_Guide_Requirements.md §5.4, §5.8.
  isCup                   Boolean                 @default(false)
  /// Bracket participant placement strategy. `random` = shuffle (existing
  /// behavior, unchanged default). `deterministic` = respect each
  /// participant's pre-assigned `slotIndex`. Rookie Cup sets this to
  /// `deterministic` to place Sterling opposite the user. See §5.9.
  seedingMode             TournamentSeedingMode   @default(random)
  games                   Game[]
  participants            TournamentParticipant[]
  rounds                  TournamentRound[]
  seedBots                TournamentSeedBot[]

  @@index([status])
  @@index([game])
  @@index([createdById])
  @@index([templateId])
  @@index([isCup])
  @@map("tournaments")
}

/// Phase 3.7a — holds recurrence *configuration* only. Never itself runs.
/// Each recurring series is one TournamentTemplate + N spawned Tournament
/// occurrences (each with `templateId` pointing back here). Subscribers
/// attach to the template; seed bots attach to the template; running state
/// (bracket, matches, results) lives exclusively on the occurrences.
model TournamentTemplate {
  id                      String                            @id @default(cuid())
  name                    String
  description             String?
  game                    String
  mode                    TournamentMode
  format                  TournamentFormat
  bracketType             BracketType
  minParticipants         Int                               @default(2)
  maxParticipants         Int?
  bestOfN                 Int                               @default(3)
  botMinGamesPlayed       Int?
  allowNonCompetitiveBots Boolean                           @default(false)
  allowSpectators         Boolean                           @default(true)
  noticePeriodMinutes     Int?
  durationMinutes         Int?
  paceMs                  Int?                              @map("pace_ms")
  startMode               TournamentStartMode               @default(AUTO)
  // Recurrence config
  recurrenceInterval      RecurrenceInterval
  /// First (or next) occurrence start — scheduler reads this to decide when
  /// to spawn the next Tournament row.
  recurrenceStart         DateTime
  recurrenceEndDate       DateTime?
  /// Registration window for the NEXT occurrence. Both advance by the
  /// recurrence interval each time the scheduler spawns an occurrence, so
  /// they always describe the upcoming occurrence. Null fields fall back
  /// to defaults at spawn time (open = now, close = startTime).
  registrationOpenAt      DateTime?
  registrationCloseAt     DateTime?
  /// Halts generation of new occurrences without cancelling the template.
  /// Running occurrences (already spawned) are unaffected.
  paused                  Boolean                           @default(false)
  autoOptOutAfterMissed   Int?
  createdById             String
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt
  /// True when created by an automated test suite.
  isTest                  Boolean                           @default(false)
  /// Bracket seeding strategy inherited by cloned occurrences. See §5.9.
  seedingMode             TournamentSeedingMode             @default(random)
  tournaments             Tournament[]
  seedBots                TournamentTemplateSeedBot[]
  subscriptions           RecurringTournamentRegistration[]

  @@index([game])
  @@index([createdById])
  @@index([paused, recurrenceStart])
  @@map("tournament_templates")
}

model TournamentParticipant {
  id                String            @id @default(cuid())
  tournamentId      String
  userId            String
  seedPosition      Int?
  eloAtRegistration Float?
  status            ParticipantStatus @default(REGISTERED)
  resultNotifPref   ResultNotifPref   @default(AS_PLAYED)
  finalPosition     Int?
  /// Normalised rank: 0.0 = winner (best), 1.0 = last place (worst). Null until tournament ends.
  finalPositionPct  Float?
  registeredAt      DateTime          @default(now())
  points            Int               @default(0)
  registrationMode  RegistrationMode  @default(SINGLE)
  tournament        Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
  @@map("tournament_participants")
}

model TournamentRound {
  id           String            @id @default(cuid())
  tournamentId String
  roundNumber  Int
  status       RoundStatus       @default(PENDING)
  createdAt    DateTime          @default(now())
  matches      TournamentMatch[]
  tournament   Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, roundNumber])
  @@index([tournamentId])
  @@map("tournament_rounds")
}

/// Ranked match — best-of-N container for casual-vs-ranked play, separate
/// from `TournamentMatch` which models bracket play. Tournament games use
/// `Game.tournamentMatchId`; ranked-match games use `Game.matchId`.
///
/// Lifecycle: PENDING (FORMING — both players set, no games yet) →
/// IN_PROGRESS (game 1 minted) → COMPLETED (winner decided or all games
/// played). CANCELLED on forfeit before game 1. Reuses the `MatchStatus`
/// enum so PENDING here == FORMING in plan-doc parlance.
///
/// `seed` is a deterministic string (UUID-ish) used by the color assigner
/// so reconnects/replays render the same colors. Game 1 color derives from
/// the seed; game 2 swaps; tournament game 3 (on `TournamentMatch`) uses a
/// fresh random call that gets announced to both clients.
model Match {
  id           String      @id @default(cuid())
  /// Game slug — "tic-tac-toe", "connect-four", etc.
  gameId       String      @map("game_id")
  format       MatchFormat @default(RANKED_BO2)
  status       MatchStatus @default(PENDING)
  player1Id    String      @map("player1_id")
  player2Id    String      @map("player2_id")
  winnerId     String?     @map("winner_id")
  p1Wins       Int         @default(0) @map("p1_wins")
  p2Wins       Int         @default(0) @map("p2_wins")
  drawGames    Int         @default(0) @map("draw_games")
  /// Deterministic seed for color assignment. Set at INSERT.
  seed         String
  startedAt    DateTime?   @map("started_at")
  completedAt  DateTime?   @map("completed_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  games        Game[]
  player1      User        @relation("Player1Matches", fields: [player1Id], references: [id])
  player2      User        @relation("Player2Matches", fields: [player2Id], references: [id])
  winner       User?       @relation("WinnerMatches", fields: [winnerId], references: [id])

  @@index([gameId])
  @@index([status])
  @@index([player1Id])
  @@index([player2Id])
  @@map("matches")
}

model TournamentMatch {
  id             String          @id @default(cuid())
  tournamentId   String
  roundId        String
  participant1Id String?
  participant2Id String?
  winnerId       String?
  status         MatchStatus     @default(PENDING)
  drawResolution String?
  p1Wins         Int             @default(0)
  p2Wins         Int             @default(0)
  drawGames      Int             @default(0)
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  games          Game[]
  round          TournamentRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([roundId])
  @@map("tournament_matches")
}

model PlayerClassification {
  id                   String                  @id @default(cuid())
  userId               String                  @unique
  tier                 ClassificationTier      @default(RECRUIT)
  merits               Int                     @default(0)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  demotionOptOutUsedAt DateTime?
  history              ClassificationHistory[]
  meritTx              MeritTransaction[]
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_classifications")
}

model MeritTransaction {
  id               String               @id @default(cuid())
  classificationId String
  tournamentId     String?
  delta            Int
  reason           String
  createdAt        DateTime             @default(now())
  classification   PlayerClassification @relation(fields: [classificationId], references: [id], onDelete: Cascade)

  @@index([classificationId])
  @@index([tournamentId])
  @@map("merit_transactions")
}

model ClassificationHistory {
  id               String               @id @default(cuid())
  classificationId String
  fromTier         ClassificationTier?
  toTier           ClassificationTier
  reason           String
  tournamentId     String?
  createdAt        DateTime             @default(now())
