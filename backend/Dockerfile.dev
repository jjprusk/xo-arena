FROM node:22-alpine
WORKDIR /app
ENV NODE_OPTIONS=--experimental-transform-types
# Copy workspace manifests + the root lockfile for layer caching. The
# lockfile is the source of truth for transitive resolution — without
# it, workspace installs silently drop deep deps (e.g. bullmq's tslib /
# msgpackr / node-abort-controller) and the image only fails at
# runtime the first time someone imports the affected module.
COPY package.json package-lock.json ./
COPY packages/ai/package.json ./packages/ai/
COPY packages/db/package.json ./packages/db/
COPY backend/package.json ./backend/
RUN npm install --workspace=backend --workspace=packages/ai --workspace=packages/db --ignore-scripts
# Copy source (overridden by volume mounts in dev)
COPY packages/ai/ ./packages/ai/
COPY packages/db/ ./packages/db/
COPY backend/ ./backend/
WORKDIR /app/backend
RUN npx prisma generate --schema=../packages/db/prisma/schema.prisma
CMD ["npm", "run", "dev"]
